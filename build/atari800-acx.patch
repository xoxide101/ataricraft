+/* ACX bank-extension register 0xd1f0 (bits 0-2: 1 MB segment, upper bits read 0); 0xd1f1 reads 0xac as an ID byte.
+   The PORTB bank number (0..63) is offset by 64 * segment. Segment 0 behaves exactly like 1088K. */
+static void ACX_SetExt(int ext)
+{
+	int newbank = 0;
+	int const old = MEMORY_xe_bank;
+	UBYTE const portb = PIA_PORTB | PIA_PORTB_mask;
+	ext &= 7;
+	if (ext == acx_ext)
+		return;
+	acx_ext = ext;
+	if ((portb & 0x30) != 0x30)
+		newbank = (((portb & 0x0e) + ((portb & 0xe0) >> 1)) >> 1) + 1 + (ext << 6);
+	if ((portb & 0x10) == 0 && newbank != old) {
+		memcpy(atarixe_memory + ((ULONG) old << 14), MEMORY_mem + 0x4000, 0x4000);
+		memcpy(MEMORY_mem + 0x4000, atarixe_memory + ((ULONG) newbank << 14), 0x4000);
+	}
+	MEMORY_xe_bank = newbank;
+}
+
+void MEMORY_ACXReset(void)
+{
+	if (MEMORY_acx && MEMORY_ram_size == 1088 && atarixe_memory != NULL)
+		ACX_SetExt(0);
+}
+
+/* ACNet register window (glue: build/ac_glue.c) */
+extern int ac_net_enabled;
+extern int ac_net_rw(int rw, int addr, int val);
+
+UBYTE ACX_D1GetByte(UWORD addr, int no_side_effects)
+{
+	if (ac_net_enabled && addr >= 0xd1a0 && addr <= 0xd1bf) return (UBYTE) ac_net_rw(no_side_effects ? 2 : 0, addr, 0);
+	if (MEMORY_acx && MEMORY_ram_size == 1088) {
+		if (addr == 0xd1f0) return (UBYTE) acx_ext;
+		if (addr == 0xd1f1) return 0xac;
+	}
+	return PBI_D1GetByte(addr, no_side_effects);
+}
+
+void ACX_D1PutByte(UWORD addr, UBYTE byte)
+{
+	if (ac_net_enabled && addr >= 0xd1a0 && addr <= 0xd1bf) {
+		ac_net_rw(1, addr, byte);
+		return;
+	}
+	if (MEMORY_acx && MEMORY_ram_size == 1088 && addr == 0xd1f0 && atarixe_memory != NULL) {
+		ACX_SetExt(byte);
+		return;
+	}
+	PBI_D1PutByte(addr, byte);
+}
