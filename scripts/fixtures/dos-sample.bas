10 REM DOS BUILD SAMPLE
20 DIM N$(20),A(5),Y$(10)
30 PRINT "HELLO FROM DOS BASIC"
40 FOR I=0 TO 5:A(I)=I*I:NEXT I
50 S=0:FOR I=0 TO 5:S=S+A(I):NEXT I
60 PRINT "SUM=";S
70 GOSUB 200
80 READ X,Y$
90 PRINT X;" ";Y$
100 IF S>50 THEN PRINT "BIG":GOTO 120
110 PRINT "SMALL"
120 N$="ATARI":PRINT LEFT$(N$,3);" ";LEN(N$);" ";N$(2,4)
130 END
200 PRINT "SUB":RETURN
300 DATA 42,"ANSWER"
