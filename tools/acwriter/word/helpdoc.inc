; Help page text (Craft stream, shown by word/home.inc). Lives at $1500 in free memory.
helpdoc
 dta b(15),b(7),b(28),b(1),c'HELP',b(1),b(13)
 dta b(13)
 dta b(1),c'Typing',b(1),b(13)
 dta c'Type to insert. Arrows move. Return ends a paragraph.',b(13)
 dta c'Backspace deletes. Ctrl-arrows move by word/page.',b(13)
 dta c'^B bold  ^I italic  ^U underline (toggle while typing).',b(13)
 dta c'Esc opens the menu bar; press the underlined letter.',b(13)
 dta c'^X opens the command line. F1 or Help = this page.',b(13)
 dta b(13)
 dta b(1),c'Menus',b(1),b(13)
 dta c'File: New Open Save Save-As, Home page, Help page.',b(13)
 dta c'Edit: Cut Copy Paste Mark Top End (no Undo yet).',b(13)
 dta c'Search: F find N next R replace G goto line,',b(13)
 dta c' S spell check (^K), D dictionary name.',b(13)
 dta c'Character: bold, italic, underline, W width, T tall,',b(13)
 dta c' L larger, S smaller, P superscript, D subscript,',b(13)
 dta c' O fonts, N no-break space, H no-break hyphen,',b(13)
 dta c' Y symbol picker (pick a symbol, Return inserts it).',b(13)
 dta c'Paragraph: L left, C centre, R right, J justify,',b(13)
 dta c' B bullet, I indent, G spacer.',b(13)
 dta c'Document: R ruler/zoom, M margins, B bars invert,',b(13)
 dta c' C colour themes, Z size, L line, H highlight,',b(13)
 dta c' G legend.',b(13)
 dta b(13)
 dta b(1),c'Files',b(1),b(13)
 dta c'Open/Save ask for a name. Without a device it is D1:',b(13)
 dta c'and .XCW is added: D1:LETTER becomes D1:LETTER.XCW.',b(13)
 dta c'H:NAME is used as typed (emulator host files).',b(13)
 dta c'Save keeps the name; Save-As asks again.',b(13)
 dta c'Format CRFT: 16 byte header + text stream, see',b(13)
 dta c'docs/CRAFT-FORMAT.md. Codes: 13 end of paragraph,',b(13)
 dta c'14 soft line end, 1 bold, 2 italic, 3 underline.',b(13)
 dta b(13)
 dta b(1),c'Import / convert',b(1),b(13)
 dta c'Open on a file without a CRFT header reads it as plain',b(13)
 dta c'text or ATASCII: lines wrap at 64 columns, inverse',b(13)
 dta c'video becomes underline, control codes are dropped.',b(13)
 dta c'Home > Convert does the same and shows the result.',b(13)
 dta c'Other formats (Letter Perfect, PaperClip, First XLEnt,',b(13)
 dta c'Text Wizard, Bank Street, RTF, Word): convert first on',b(13)
 dta c'the PC with tools/craftimport.cjs (see docs/IMPORT.md);',b(13)
 dta b(13)
 dta b(1),c'Start menu',b(1),b(13)
 dta c'N new  O open  S save  A save as  C convert  H help',b(13)
 dta c'E or Esc: back to the document (it stays in memory).',b(13)
 dta c'Up/Down + Return also pick an entry. T cycles colours.',b(13)
 dta b(13)
 dta b(1),c'Select / copy / find',b(1),b(13)
 dta c'^S mark, then arrows extend; ^S or Esc clears.',b(13)
 dta c'^Y copy  ^D cut  ^P paste (clipboard 384 bytes; with',b(13)
 dta c'no mark they take the current line). Style kept.',b(13)
 dta c'^F find (Return)  ^G next  ^R replace: Y N A Esc',b(13)
 dta c'^L goto line  ^A line start  ^E line end.',b(13)
 dta c'Find ignores case and wraps round the document.',b(13)
 dta b(13)
 dta b(1),c'Spell check',b(1),b(13)
 dta c'^K or Search > Spell check checks from the cursor and',b(13)
 dta c'stops on each unknown word (shown inverse):',b(13)
 dta c' I ignore  A ignore for this session  Esc stop',b(13)
 dta c' 1-5 replace with a suggestion (a letter deleted or',b(13)
 dta c' two swapped)  Return/N next. Needs D1:EN.CDC or',b(13)
 dta c'H:EN.CDC; a 130XE is needed for the 16 KB table.',b(13)
 dta c'See docs/SPELL.md and docs/DICTIONARY.md.',b(13)
 dta b(0)

; line 0 is the logo; entries start at line EL0, each 12 scanlines tall at double width
; the home and convert pages are image 4 of the overlay manager (expanded by poc5.asm), shown from the slot
 .macro homebody
 dta b(15),b(10),b(30),b(1),c'A C  W R I T E R',b(1),b(13)
 dta b(15),b(5),c'----------------------------------------------------------------',b(13)
 dta b(15),c'Word processor for the Atari 8-bit',b(13)
 dta b(15),c'Version '
 icl 'word/version.inc'
 dta c' proof of concept',b(13)
 dta b(13)
 dta b(7),b(28),b(31),c'    N   New document       ',b(31),b(13)
 dta b(7),b(28),b(31),c'    O   Open document      ',b(31),b(13)
 dta b(7),b(28),b(31),c'    S   Save               ',b(31),b(13)
 dta b(7),b(28),b(31),c'    A   Save as            ',b(31),b(13)
 dta b(7),b(28),b(31),c'    C   Convert / import   ',b(31),b(13)
 dta b(7),b(28),b(31),c'    H   Help (F1)          ',b(31),b(13)
 dta b(7),b(28),b(31),c'    E   Edit document      ',b(31),b(13)
 dta b(7),b(28),b(31),c'    Q   Quit               ',b(31),b(13)
 dta b(0)

 .endm
 .macro convbody
 dta b(15),b(7),b(28),b(1),c'CONVERT / IMPORT',b(1),b(13)
 dta b(13)
 dta c'Reads a plain text or ATASCII file and turns it into an',b(13)
 dta c'ACWriter document. It replaces the document in memory.',b(13)
 dta c' - lines wrap at 64 columns (soft breaks)',b(13)
 dta c' - inverse video becomes underline',b(13)
 dta c' - Ctrl-C at the start of a line centres it',b(13)
 dta c' - other control codes are dropped',b(13)
 dta b(13)
 dta c'Press I or Return, then type the file name. The default',b(13)
 dta c'device is D1:  H:NAME works in the emulator.',b(13)
 dta c'File > Open does the same for any file that is not an',b(13)
 dta c'ACWriter (CRFT) file.',b(13)
 dta b(13)
 dta c'Letter Perfect, PaperClip, Text Wizard, Bank Street,',b(13)
 dta c'RTF and Word files: convert on the PC first with',b(13)
 dta c'  node tools/craftimport.cjs INPUT OUTPUT.XCW',b(13)
 dta c'Then press E to edit the result.',b(13)
 dta b(0)
 .endm
