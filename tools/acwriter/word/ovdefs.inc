; Variables and constants shared by the resident code and the overlay images (page, spell, edit).
PGV    = 4
pwx    = $13E5               ; first paper column on screen
pwrow  = $13E6
pwsp   = $13E7               ; 1 superscript, 2 subscript
pwsc   = $13E8               ; screen column being drawn
pwpap  = $13E9               ; 0 letter, 1 A4, 2 legal
pwpit  = $13EA               ; 0 10 cpi, 1 12 cpi, 2 17 cpi
pwplm  = $13EB               ; left margin, columns
pwprm  = $13EC               ; right margin, columns
pwcols = $13ED               ; columns across the paper
pwwid  = $13EE               ; usable columns
pwlpp  = $13EF               ; text lines per page
pwsl   = $13F0               ; saved lm / rm of the normal view
pwsr   = $13F1
pwcv   = $13F2               ; cursor column (visible characters before it)
pwnt   = $13F3               ; tab stops
pwcc   = $13F4
pwch   = $13F5
pwchg  = $13F6
pwol   = $13F7               ; previous cursor line
pwii    = $13F8
pwdl   = $13F9
pwdh   = $13FA
pwa    = $13FB
pwb    = $13FC
pwc    = $13FD
pwvx   = $13FE
pwvw   = $13FF
pwvy   = $14E1
pwm0   = $14E2
pwm1   = $14E3
pwm2   = $14E4
pwo    = $14E5               ; cursor pointer saved over a rewrap (2)
pwtp   = $14E8               ; tab stop columns on the paper (8)
pwtk   = $14F0               ; kinds 0 left, 1 centre, 2 right (8)
pzoom  = $14E7               ; 1 = PAGE mode shows the 2x zoom (word/zoom.inc)
; typeface state (word/fontz.inc): bank 3 holds up to 4 loaded 8x8 charsets (1 KB each); slot 0 is the OS ROM set
fpn    = $0781               ; font changes in the table
fns    = $0782               ; loaded fonts (slots 1..fns)
fz1    = $0783               ; scratch
fz2    = $0784
fz3    = $0785
fz4    = $0786
fz5    = $0787
fnm    = $0788               ; 4 names x 16 bytes (12 letters, 0 end, byte 15: 0 loaded, 1 pending, 2 failed)
fpi    = $07C8               ; change table: paragraph number (sorted), 8 entries
fps    = $07D0               ; its font slot
FG8    = $07D8               ; the 8 glyph bytes being drawn
fz6    = $07E0
fz7    = $07E1
fz8    = $07E2
fzp    = $07E3               ; paragraph of the line being drawn
fzf    = $07E4               ; font slot of that line
sv_nb  = $07E5               ; extended banks found at startup (bk_cnt)
; document segments (word/segx.inc, docs/ACWRITER-PAGE.md): segment i lives in bank 4+i while another one is in DOC
sg_n   = $07E6               ; segments (0 = one plain document)
sg_c   = $07E7               ; segment now in DOC
sg_ok  = $07E8               ; result of a segmented load: 1 ok, 2 checksum, 3 i/o error
sgbk   = $07E9
sgd    = $07EA
sgp    = $07EB
sg_tl  = $07EC               ; 16 bit total / remaining length
sg_th  = $07ED
sg_cl  = $07EE               ; 16 bit checksum
sg_ch  = $07EF
sg_i   = $07F0
sl_b   = $07F1               ; tail byte hidden by a segment terminator while it is parked
sl_pl  = $07F2
sl_ph  = $07F3
sg_mx  = $07F4               ; most segments this machine can hold
SWB  = $1380                  ; spell: word, 24 letter codes (a=1..z=26, apostrophe=27)
DNM  = $1450                 ; dictionary file name, 0x9B ended
ISB  = $9B00                 ; session ignore list: 32 entries x 4 byte hash
SGB  = $9B80                 ; suggestions: 5 x 25 bytes (length + codes)
LDB  = $9F00                 ; 256 byte load buffer (also the overlay copy buffer)
