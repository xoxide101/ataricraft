    29 5103			 icl 'word/ovl.inc'
Source: ovl.inc
     1 				; Overlay manager (resident part). The spell, edit and page code is assembled at SLA (one shared slot in
     2 				; main RAM) and stored in 130XE bank 2; a stub swaps the right image in before jumping to the routine.
     3 				; Needs the 128K machine (sv_xe = 1). Image ids: 0 = edit, 1 = spell, 2 = page.
     4 = 14F8			ovid  = $14F8                  ; image now in the slot ($FF = none)
     5 = 14F9			ovsa  = $14F9
     6 = 14FA			ovsx  = $14FA
     7 = 14FB			ovsy  = $14FB
     8 = 14FC			ovtg  = $14FC                  ; 2 bytes, followed by ovrq: the stub's inline data (target, image id)
     9 = 14FE			ovrq  = $14FE
    10
    11 				; ovstub name, target, image: 9 bytes; the JSR leaves the address of the inline data on the stack
    12 				 .macro ovstub
    13 				 sta ovsa
    14 				 jsr ovc
    15 				 dta a(:1),b(:2)
    16 				 .endm
    17
    18 5103 8E FA 14		ovc stx ovsx
    19 5106 8C FB 14		 sty ovsy
    20 5109 68			 pla
    21 510A 18			 clc
    22 510B 69 01		 adc #1
    23 510D 8D 19 51		 sta ovq+1
    24 5110 68			 pla
    25 5111 69 00		 adc #0
    26 5113 8D 1A 51		 sta ovq+2
    27 5116 A0 02		 ldy #2
    28 5118 B9 FF FF		ovq lda $FFFF,y
    29 511B 99 FC 14		 sta ovtg,y
    30 511E 88			 dey
    31 511F 10 F7		 bpl ovq
    32 5121 AD F8 14		 lda ovid
    33 5124 CD FE 14		 cmp ovrq
    34 5127 F0 21		 beq ov_go
    35 5129 AD 5C 13		 lda sv_xe
    36 512C F0 28		 beq ov_no
    37 512E AD F8 14		 lda ovid
    38 5131 C9 02		 cmp #2
    39 5133 90 12		 bcc ov_sw
    40 5135 C9 04		 cmp #4
    41 5137 F0 0E		 beq ov_sw
    42 5139 AD FE 14		 lda ovrq
    43 513C C9 02		 cmp #2
    44 513E B0 07		 bcs ov_sw
    45 5140 AD 30 13		 lda hmode
    46 5143 C9 04		 cmp #PGV
    47 5145 F0 0F		 beq ov_no
    48 5147 20 A2 96		ov_sw jsr ovlsw
    49 514A AE FA 14		ov_go ldx ovsx
    50 514D AC FB 14		 ldy ovsy
    51 5150 AD F9 14		 lda ovsa
    52 5153 6C FC 14		 jmp (ovtg)
    53 				; refused: no extended RAM, or an edit/spell command while the page view is running
    54 5156 A9 28		ov_no lda #40
    55 5158 85 AC		 sta cmsg
    56 515A AE FA 14		 ldx ovsx
    57 515D AC FB 14		 ldy ovsy
    58 5160 18			 clc
    59 5161 60			 rts
