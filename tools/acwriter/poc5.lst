    23 				 .macro body
    24 				 dta b(1),c'ACWriter',b(1),c' hi-res page: 64 columns x 20 lines',b(13)
    25 				 dta c'Normal, ',b(1),c'bold',b(1),c', ',b(2),c'italic',b(2),c' and ',b(4-1),c'underline',b(3),c' text.',b(13)
    26 				 dta c'The quick brown fox jumps over a lazy dog 0123456789',b(13)
    27 				 dta b(13)
    28 				 dta c'Every glyph is drawn bit by bit at 5 pixels per',b(13)
    29 				 dta c'character, so 64 columns fit across the page and',b(13)
    30 				 dta c'the cursor can sit on any of 21 text lines.',b(13)
    31 				 dta b(13)
    32 				 dta b(1),b(2),c'Bold italic',b(2),b(1),c' works too, and ',b(3),b(1),c'bold underline',b(1),b(3),c'.',b(13)
    33 				 dta c'Type here: letters insert, Return splits a line,',b(13)
    34 				 dta c'backspace deletes and joins lines, Ctrl-arrows move',b(13)
    35 				 dta b(13)
    36 				 dta c'Scrolling is a block copy of 21 rows followed by',b(13)
    37 				 dta c'drawing a single new line at the edge.',b(13)
    38 				 dta b(13)
    39 				 dta c'Objects, not bitmaps: the document is a short',b(13)
    40 				 dta c'text stream with style codes, so it stays tiny.',b(13)
    41 				 dta b(13)
    42 				 dta c'A 1-page document fits in a few KB on a stock',b(13)
    43 				 dta c'64K XL or XE, leaving the rest for art and fonts.',b(13)
    44 				 dta b(13)
    45 				 dta c'-- end of this block --',b(13)
    46 				 .endm
    47
    48 6164			 org DOC
    49 6600			 body
