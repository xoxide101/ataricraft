    28 4D0E			 icl 'word/msgs.inc'
Source: msgs.inc
     1 				; Message line texts (cmsg 20..39). Resident: the status line draws them in every mode, while the
     2 				; spell, edit and page code lives in the overlay slot (ovl.inc) and is swapped in on use.
     3 = 9C00			MSB = $9C00
     4 4D0E			spmsg
     5 4D0E A5 AC		 lda cmsg
     6 4D10 C9 14		 cmp #20
     7 4D12 D0 03		 bne spmx
     8 4D14 4C AB 51		 jmp o_spm20
     9 4D17 C9 21		spmx cmp #33
    10 4D19 D0 03		 bne spmy
    11 4D1B 4C 32 52		 jmp o_exrepm
    12 4D1E C9 1B		spmy cmp #27
