    35 9326 6D 5D 13		 adc sv_tb
    36 9329 8D 41 93		 sta bkp1+2
    37 932C AD 5C 13		 lda sv_xe
    38 932F F0 09		 beq bkp0
    39 9331 20 46 93		 jsr bk_in
    40 9334 20 3A 93		 jsr bkp
    41 9337 4C 5A 93		 jmp bk_out
    42 933A			bkp0
    43 933A A0 00		bkp ldy #0
    44 933C B9 00 9F		bkp2 lda LDB,y
    45 933F 99 00 FF		bkp1 sta $FF00,y
