    42 1ADE 54 65 78 74 20 57 +  dta c'Text Wizard, Bank Street, RTF, Word): convert first on',b(13)
    43 1B15 74 68 65 20 50 43 +  dta c'the PC with tools/craftimport.cjs (see docs/IMPORT.md);',b(13)
    44 1B4D 0D			 dta b(13)
    45 1B4E 01 53 74 61 72 74 +  dta b(1),c'Start menu',b(1),b(13)
