    20 4B09			 icl 'word/import.inc'
Source: import.inc
     1 				; Plain text / ATASCII import: reads the file named in FNB one byte at a time through CIO and
     2 				; writes a Craft stream at DOC (rules follow fromAtascii in tools/craftimport.cjs: line ends
     3 				; $9B/$0D/$0A, wrap at 64 columns with soft break 14, hard end 13, inverse -> underline 3,
     4 				; $03 at line start -> centre marker 15 / right 16, control bytes dropped).
     5 = 0083			ILIM = $83
     6 4B09			doimport
     7 4B09 A9 00		 lda #<DOC
     8 4B0B 85 A6		 sta dend
