   533 				; --------------------------------------------------------------- glyph blitter
   534 				; A = character 32..127, pwsc = screen column (0..79), sp = row top, lo = byte offset of the first
   535 				; glyph row (80 normal, 0 superscript, 200 subscript). Cells are 4 px: two per byte.
   536 				.macro ge pl
   537 				 lda :pl,x
   538 				 ora (gp),y
