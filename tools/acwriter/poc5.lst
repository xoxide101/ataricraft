    52 1C4A 5E 58 20 63 75 74 +  dta c'^X cut  ^C/^Y copy  ^V/^P paste  Del cut  typing replaces',b(13)
    53 1C84 28 63 6C 69 70 62 +  dta c'(clipboard 384 bytes; no mark: current line).',b(13)
