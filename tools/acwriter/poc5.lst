    69 				; bank 3 holds the loaded typefaces ($4000.., 1 KB each). fb_put: copy LDB to bank 3 page A ($40..$7F)
    70 9367			fb_put
    71 9367 8D 74 93		 sta fbp+2
    72 936A 20 8B 93		 jsr fb_in
