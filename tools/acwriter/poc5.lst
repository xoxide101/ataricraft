Macro: CONVBODY [Source: helpdoc.inc]
     1 599D 0F 07 1C 01 43 4F +  dta b(15),b(7),b(28),b(1),c'CONVERT / IMPORT',b(1),b(13)
     2 59B3 0D			 dta b(13)
     3 59B4 52 65 61 64 73 20 +  dta c'Reads a plain text or ATASCII file and turns it into an',b(13)
     4 59EC 41 43 57 72 69 74 +  dta c'ACWriter document. It replaces the document in memory.',b(13)
     5 5A23 20 2D 20 6C 69 6E +  dta c' - lines wrap at 64 columns (soft breaks)',b(13)
     6 5A4D 20 2D 20 69 6E 76 +  dta c' - inverse video becomes underline',b(13)
     7 5A70 20 2D 20 43 74 72 +  dta c' - Ctrl-C at the start of a line centres it',b(13)
     8 5A9C 20 2D 20 6F 74 68 +  dta c' - other control codes are dropped',b(13)
     9 5ABF 0D			 dta b(13)
    10 5AC0 50 72 65 73 73 20 +  dta c'Press I or Return, then type the file name. The default',b(13)
    11 5AF8 64 65 76 69 63 65 +  dta c'device is D1:  H:NAME works in the emulator.',b(13)
    12 5B25 46 69 6C 65 20 3E +  dta c'File > Open does the same for any file that is not an',b(13)
    13 5B5B 41 43 57 72 69 74 +  dta c'ACWriter (CRFT) file.',b(13)
    14 5B71 0D			 dta b(13)
