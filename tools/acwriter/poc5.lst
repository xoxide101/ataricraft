    28 4D28			 icl 'word/msgs.inc'
Source: msgs.inc
     1 				; Message line texts (cmsg 20..39). Resident: the status line draws them in every mode, while the
     2 				; spell, edit and page code lives in the overlay slot (ovl.inc) and is swapped in on use.
     3 = 9C00			MSB = $9C00
     4 4D28			spmsg
     5 4D28 A5 AC		 lda cmsg
     6 4D2A C9 14		 cmp #20
     7 4D2C D0 03		 bne spmx
     8 4D2E 4C C5 51		 jmp o_spm20
     9 4D31 C9 21		spmx cmp #33
    10 4D33 D0 03		 bne spmy
    11 4D35 4C 4C 52		 jmp o_exrepm
    12 4D38 C9 1B		spmy cmp #27
    13 4D3A 90 11		 bcc spmz
    14 4D3C 38			 sec
    15 4D3D E9 1B		 sbc #27
    16 4D3F 0A			 asl
    17 4D40 AA			 tax
    18 4D41 BD 37 4E		 lda exmt,x
    19 4D44 48			 pha
    20 4D45 BD 38 4E		 lda exmt+1,x
    21 4D48 AA			 tax
    22 4D49 68			 pla
    23 4D4A 4C 23 44		 jmp putstr
    24 4D4D 38			spmz sec
