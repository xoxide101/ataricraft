    32 5167 AD F8 14		 lda ovid
    33 516A CD FE 14		 cmp ovrq
    34 516D F0 21		 beq ov_go
    35 516F AD 5C 13		 lda sv_xe
    36 5172 F0 28		 beq ov_no
    37 5174 AD F8 14		 lda ovid
    38 5177 C9 02		 cmp #2
    39 5179 90 12		 bcc ov_sw
    40 517B C9 04		 cmp #4
    41 517D F0 0E		 beq ov_sw
    42 517F AD FE 14		 lda ovrq
    43 5182 C9 02		 cmp #2
    44 5184 B0 07		 bcs ov_sw
    45 5186 AD 30 13		 lda hmode
    46 5189 C9 04		 cmp #PGV
    47 518B F0 0F		 beq ov_no
    48 518D 20 A2 96		ov_sw jsr ovlsw
