   140 1F55			 icl 'word/cursor.inc'
Source: cursor.inc
     1 				; Text-mode cursor: an XOR block over the character cell at the cursor, blinking from RTCLOK.
     2 				; It is erased when a key arrives (before anything is redrawn) and measured and drawn again from the idle
     3 				; loop, so typing never redraws the line just to blink it. The position comes from a measure-only drawtext
     4 				; pass: drawtext skips every glyph (dfrom = $FF, cumeas = $FF) and cuhit records where the cursor byte lands.
     5 = 05E0			cuon   = $05E0                 ; 0 / $20: the block is currently XORed onto the screen
     6 = 05E1			cuval  = $05E1                 ; 1 = cux/cuh/cura describe the current cursor
     7 = 05E2			cuok   = $05E2                 ; 1 = the cursor is on a visible line
     8 = 05E3			cumeas = $05E3                 ; $FF while measuring
     9 = 05E4			cubase = $05E4                 ; RTCLOK+2 at the last key (blink restarts "on")
    10 = 05E5			cuptr  = $05E5                 ; 2 bytes: raw document address of the cursor
    11 = 05E7			cux    = $05E7                 ; 2 bytes: pixel x
    12 = 05E9			cuw    = $05E9
    13 = 05EA			cuh    = $05EA
    14 = 05EB			cura   = $05EB                 ; 2 bytes: address of the line's first scanline
    15 = 05ED			cum0   = $05ED
    16 = 05EE			cum1   = $05EE
    17 = 05EF			cum2   = $05EF
    18 = 05F0			cuby   = $05F0
    19 = 05F1			rbsp   = $05F1                 ; 2 bytes: screen address of the line being redrawn through RB
    20 = 05F3			rdfc   = $05F3                 ; 1 = next status/ruler draw clears its row first (explicit redraw)
    21 = 05F4			qql    = $05F4
    22 = 05F5			qqp    = $05F5
    23 = 05F6			qqt    = $05F6
    24 = 05F7			qqn    = $05F7
    25 = BE60			RB     = $BE60               ; one 8-scanline text line (320 bytes) drawn off screen, then copied in one go
    26
