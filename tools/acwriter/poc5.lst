    21 17AA 50 61 72 61 67 72 +  dta c'Paragraph: L left, C centre, R right, J justify,',b(13)
    22 17DB 20 42 20 62 75 6C +  dta c' B bullet, I indent, G spacer.',b(13)
    23 17FA 44 6F 63 75 6D 65 +  dta c'Document: R ruler/zoom, M margins, B bars invert,',b(13)
    24 182C 20 43 20 63 6F 6C +  dta c' C colour themes, Z size, L line, H highlight,',b(13)
    25 185B 20 47 20 6C 65 67 +  dta c' G legend.',b(13)
