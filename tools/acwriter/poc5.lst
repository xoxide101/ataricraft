     1 				; Help page text (Craft stream, shown by word/home.inc). Lives at $1500 in free memory.
     2 1500			helpdoc
     3 1500-1FE3> 0F 07 1C 01 +  dta b(15),b(7),b(28),b(1),c'HELP',b(1),b(13)
     4 150A 0D			 dta b(13)
     5 150B 01 54 79 70 69 6E +  dta b(1),c'Typing',b(1),b(13)
     6 1514 54 79 70 65 20 74 +  dta c'Type to insert. Arrows move. Return ends a paragraph.',b(13)
     7 154A 42 61 63 6B 73 70 +  dta c'Backspace deletes. Ctrl-arrows move by word/page.',b(13)
     8 157C 5E 42 20 62 6F 6C +  dta c'^B bold  ^I italic  ^U underline (toggle while typing).',b(13)
     9 15B4 45 73 63 20 6F 70 +  dta c'Esc opens the menu bar; press the underlined letter.',b(13)
    10 15E9 5E 58 20 6F 70 65 +  dta c'^X opens the command line. F1 or Help = this page.',b(13)
    11 161C 0D			 dta b(13)
    12 161D 01 4D 65 6E 75 73 +  dta b(1),c'Menus',b(1),b(13)
    13 1625 46 69 6C 65 3A 20 +  dta c'File: New Open Save Save-As, Home page, Help page.',b(13)
    14 1658 45 64 69 74 3A 20 +  dta c'Edit: Top and End work. Undo/Cut/Copy/Paste: not yet.',b(13)
    15 168E 53 65 61 72 63 68 +  dta c'Search: not yet.',b(13)
    16 169F 43 68 61 72 61 63 +  dta c'Character: bold, italic, underline, W width, T tall,',b(13)
    17 16D4 20 4C 20 6C 61 72 +  dta c' L larger, S smaller, P superscript, D subscript,',b(13)
    18 1706 20 4F 20 66 6F 6E +  dta c' O fonts, N no-break space, H no-break hyphen,',b(13)
    19 1735 20 59 20 73 79 6D +  dta c' Y symbol picker (pick a symbol, Return inserts it).',b(13)
    20 176A 50 61 72 61 67 72 +  dta c'Paragraph: L left, C centre, R right, J justify,',b(13)
    21 179B 20 42 20 62 75 6C +  dta c' B bullet, I indent, G spacer.',b(13)
    22 17BA 44 6F 63 75 6D 65 +  dta c'Document: R ruler/zoom, M margins, B bars invert,',b(13)
    23 17EC 20 43 20 63 6F 6C +  dta c' C colour themes, Z size, L line, H highlight,',b(13)
    24 181B 20 47 20 6C 65 67 +  dta c' G legend.',b(13)
    25 1826 0D			 dta b(13)
    26 1827 01 46 69 6C 65 73 +  dta b(1),c'Files',b(1),b(13)
    27 182F 4F 70 65 6E 2F 53 +  dta c'Open/Save ask for a name. Without a device it is D1:',b(13)
    28 1864 61 6E 64 20 2E 43 +  dta c'and .CWD is added: D1:LETTER becomes D1:LETTER.CWD.',b(13)
    29 1898 48 3A 4E 41 4D 45 +  dta c'H:NAME is used as typed (emulator host files).',b(13)
    30 18C7 53 61 76 65 20 6B +  dta c'Save keeps the name; Save-As asks again.',b(13)
    31 18F0 46 6F 72 6D 61 74 +  dta c'Format CRFT: 16 byte header + text stream, see',b(13)
    32 191F 64 6F 63 73 2F 43 +  dta c'docs/CRAFT-FORMAT.md. Codes: 13 end of paragraph,',b(13)
    33 1951 31 34 20 73 6F 66 +  dta c'14 soft line end, 1 bold, 2 italic, 3 underline.',b(13)
    34 1982 0D			 dta b(13)
    35 1983 01 49 6D 70 6F 72 +  dta b(1),c'Import / convert',b(1),b(13)
    36 1996 4F 70 65 6E 20 6F +  dta c'Open on a file without a CRFT header reads it as plain',b(13)
    37 19CD 74 65 78 74 20 6F +  dta c'text or ATASCII: lines wrap at 64 columns, inverse',b(13)
    38 1A00 76 69 64 65 6F 20 +  dta c'video becomes underline, control codes are dropped.',b(13)
    39 1A34 48 6F 6D 65 20 3E +  dta c'Home > Convert does the same and shows the result.',b(13)
    40 1A67 4F 74 68 65 72 20 +  dta c'Other formats (Letter Perfect, PaperClip, First XLEnt,',b(13)
    41 1A9E 54 65 78 74 20 57 +  dta c'Text Wizard, Bank Street, RTF, Word): convert first on',b(13)
    42 1AD5 74 68 65 20 50 43 +  dta c'the PC with tools/craftimport.cjs (see docs/IMPORT.md);',b(13)
    43 1B0D 0D			 dta b(13)
    44 1B0E 01 53 74 61 72 74 +  dta b(1),c'Start menu',b(1),b(13)
    45 1B1B 4E 20 6E 65 77 20 +  dta c'N new  O open  S save  A save as  C convert  H help',b(13)
    46 1B4F 45 20 6F 72 20 45 +  dta c'E or Esc: back to the document (it stays in memory).',b(13)
    47 1B84 55 70 2F 44 6F 77 +  dta c'Up/Down + Return also pick an entry. T cycles colours.',b(13)
