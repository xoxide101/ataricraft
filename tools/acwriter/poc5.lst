    30 53FF			 icl 'word/diskfs.inc'
Source: diskfs.inc
     1 				; D: device handler for the self-booting ACWriter disk. A small Atari DOS 2 compatible file system (single
     2 				; density, 128 byte sectors): VTOC at sector 360, directory at 361..368, data sectors with the usual 3 byte
     3 				; link (125 data bytes, file number + next sector, byte count). One file open at a time, read (4) or write (8);
     4 				; writing an existing name replaces it. The disk is laid out by scripts/build-acwriter-atr.cjs.
     5 				; It is installed by ddinit only when no D: handler exists (so under a real DOS, DOS keeps D:).
     6 = 0400			DDB  = $0400                   ; data sector buffer (cassette buffer)
     7 = 0300			DDEVIC = $0300
     8 = 0301			DUNIT  = $0301
     9 = 0302			DCOMND = $0302
    10 = 0303			DSTATS = $0303
    11 = 0304			DBUFLO = $0304
    12 = 0305			DBUFHI = $0305
    13 = 0306			DTIMLO = $0306
    14 = 0308			DBYTLO = $0308
    15 = 0309			DBYTHI = $0309
    16 = 030A			DAUX1  = $030A
    17 = 030B			DAUX2  = $030B
    18 = E459			SIOV   = $E459
    19 = 031A			HATABS = $031A
    20 = 9F00			DDR  = $9F00                   ; directory sector buffer (shares LDB, only used inside one call)
    21 = 9F80			DDV  = $9F80                   ; VTOC sector buffer, kept while a file is open for writing
    22 = BFA0			ddz  = $BFA0                   ; state
    23 = BFA0			ddmo = ddz                     ; open mode, 0 = closed
    24 = BFA1			ddsc = ddz+1                   ; sector in the data buffer (2)
    25 = BFA3			ddpo = ddz+3                   ; read / write position
    26 = BFA4			ddct = ddz+4                   ; bytes in the sector being read
    27 = BFA5			ddnx = ddz+5                   ; next sector (2)
    28 = BFA7			ddtd = ddz+7                   ; directory sector (low byte) and offset of the file's entry
    29 = BFA8			ddto = ddz+8
    30 = BFA9			ddff = ddz+9                   ; 1 = name found
    31 = BFAA			ddfs = ddz+10                  ; 1 = a free entry was seen
    32 = BFAB			ddn4 = ddz+11                  ; file number << 2
    33 = BFAC			ddst = ddz+12                  ; first sector of the file (2)
    34 = BFAE			ddcn = ddz+14                  ; sectors written (2)
    35 = BFB0			ddnw = ddz+16                  ; sector just allocated (2)
    36 = BFB2			ddbc = ddz+18                  ; bytes written (3)
    37 = BFB5			ddt1 = ddz+21
    38 = BFB6			ddt2 = ddz+22
    39 = BFB8			ddnm = ddz+24                  ; packed name, 8 + 3 letters
    40
