Source: segx.inc
     1 				; Document segments: bank copy of the whole DOC area. Resident (the bank window hides $4000-$7FFF, DOC included),
     2 				; so every page goes through LDB. Segment i is kept in extended bank number 4+i; page 44 of the bank carries the length.
     3 				; sg_x: X = bank number, A bit 0 = 0 saves DOC to the bank, 1 loads DOC from it (dend is set from the length page).
     4 1E93			sg_x
     5 1E93-1F54> 8E E9 07	 stx sgbk
     6 1E96 29 01		 and #1
     7 1E98 8D EA 07		 sta sgd
     8 1E9B A9 00		 lda #0
     9 1E9D 8D EB 07		 sta sgp
    10 1EA0 AD EB 07		sgl lda sgp
    11 1EA3 18			 clc
    12 1EA4 69 64		 adc #>DOC
    13 1EA6 8D C8 1E		 sta sgs+2
    14 1EA9 8D 1C 1F		 sta sgt+2
    15 1EAC AD EB 07		 lda sgp
    16 1EAF 18			 clc
    17 1EB0 69 40		 adc #$40
    18 1EB2 8D F3 1E		 sta sgw+2
    19 1EB5 8D 04 1F		 sta sgr+2
    20 1EB8 AD EA 07		 lda sgd
    21 1EBB D0 40		 bne sgld
    22 1EBD AD EB 07		 lda sgp
    23 1EC0 C9 2C		 cmp #44
    24 1EC2 F0 0D		 beq sgmeta
    25 1EC4 A0 00		 ldy #0
    26 1EC6 B9 00 FF		sgs lda $FF00,y
    27 1EC9 99 00 9F		 sta LDB,y
    28 1ECC C8			 iny
    29 1ECD D0 F7		 bne sgs
    30 1ECF F0 18		 beq sgbp
    31 1ED1 A0 00		sgmeta ldy #0
    32 1ED3 98			 tya
    33 1ED4 99 00 9F		sgz sta LDB,y
    34 1ED7 C8			 iny
    35 1ED8 D0 FA		 bne sgz
    36 1EDA A5 A6		 lda dend
    37 1EDC 38			 sec
    38 1EDD E9 00		 sbc #<DOC
    39 1EDF 8D 00 9F		 sta LDB
    40 1EE2 A5 A7		 lda dend+1
    41 1EE4 E9 64		 sbc #>DOC
    42 1EE6 8D 01 9F		 sta LDB+1
    43 1EE9 20 43 1F		sgbp jsr sg_in
    44 1EEC A0 00		 ldy #0
    45 1EEE B9 00 9F		sgq lda LDB,y
    46 1EF1 99 00 FF		sgw sta $FF00,y
    47 1EF4 C8			 iny
    48 1EF5 D0 F7		 bne sgq
    49 1EF7 20 91 22		 jsr bk_out
    50 1EFA 4C 20 1F		 jmp sgnx
    51 1EFD 20 43 1F		sgld jsr sg_in
    52 1F00 A0 00		 ldy #0
    53 1F02 B9 00 FF		sgr lda $FF00,y
    54 1F05 99 00 9F		 sta LDB,y
    55 1F08 C8			 iny
    56 1F09 D0 F7		 bne sgr
    57 1F0B 20 91 22		 jsr bk_out
    58 1F0E AD EB 07		 lda sgp
    59 1F11 C9 2C		 cmp #44
    60 1F13 F0 19		 beq sgdn
    61 1F15 A0 00		 ldy #0
    62 1F17 B9 00 9F		sgu lda LDB,y
    63 1F1A 99 00 FF		sgt sta $FF00,y
    64 1F1D C8			 iny
    65 1F1E D0 F7		 bne sgu
    66 1F20 EE EB 07		sgnx inc sgp
    67 1F23 AD EB 07		 lda sgp
    68 1F26 C9 2D		 cmp #45
    69 1F28 B0 03		 bcs sgx9
    70 1F2A 4C A0 1E		 jmp sgl
    71 1F2D 60			sgx9 rts
    72 1F2E AD 00 9F		sgdn lda LDB
    73 1F31 18			 clc
    74 1F32 69 00		 adc #<DOC
    75 1F34 85 A6		 sta dend
    76 1F36 AD 01 9F		 lda LDB+1
    77 1F39 69 64		 adc #>DOC
    78 1F3B 85 A7		 sta dend+1
    79 1F3D A0 00		 ldy #0
    80 1F3F 98			 tya
    81 1F40 91 A6		 sta (dend),y
    82 1F42 60			 rts
    83
    84 1F43 78			sg_in sei
    85 1F44 A9 00		 lda #0
    86 1F46 8D 0E D4		 sta NMIEN
    87 1F49 AD 01 D3		 lda PORTB
