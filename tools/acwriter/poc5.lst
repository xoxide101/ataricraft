Source: ovl.inc
     1 				; Overlay manager (resident part). The spell, edit and page code is assembled at SLA (one shared slot in
     2 				; main RAM) and stored in 130XE bank 2; a stub swaps the right image in before jumping to the routine.
     3 				; Needs the 128K machine (sv_xe = 1). Image ids: 0 = edit, 1 = spell, 2 = page.
     4 = 14F8			ovid  = $14F8                  ; image now in the slot ($FF = none)
     5 = 14F9			ovsa  = $14F9
     6 = 14FA			ovsx  = $14FA
     7 = 14FB			ovsy  = $14FB
     8 = 14FC			ovtg  = $14FC                  ; 2 bytes, followed by ovrq: the stub's inline data (target, image id)
     9 = 14FE			ovrq  = $14FE
    10
    11 				; ovstub name, target, image: 9 bytes; the JSR leaves the address of the inline data on the stack
    12 				 .macro ovstub
    13 				 sta ovsa
    14 				 jsr ovc
    15 				 dta a(:1),b(:2)
    16 				 .endm
    17
    18 50DC 8E FA 14		ovc stx ovsx
    19 50DF 8C FB 14		 sty ovsy
    20 50E2 68			 pla
    21 50E3 18			 clc
    22 50E4 69 01		 adc #1
    23 50E6 8D F2 50		 sta ovq+1
    24 50E9 68			 pla
    25 50EA 69 00		 adc #0
    26 50EC 8D F3 50		 sta ovq+2
    27 50EF A0 02		 ldy #2
    28 50F1 B9 FF FF		ovq lda $FFFF,y
    29 50F4 99 FC 14		 sta ovtg,y
    30 50F7 88			 dey
    31 50F8 10 F7		 bpl ovq
    32 50FA AD F8 14		 lda ovid
    33 50FD CD FE 14		 cmp ovrq
    34 5100 F0 21		 beq ov_go
    35 5102 AD 5C 13		 lda sv_xe
    36 5105 F0 28		 beq ov_no
    37 5107 AD F8 14		 lda ovid
    38 510A C9 02		 cmp #2
    39 510C 90 12		 bcc ov_sw
    40 510E C9 04		 cmp #4
    41 5110 F0 0E		 beq ov_sw
    42 5112 AD FE 14		 lda ovrq
    43 5115 C9 02		 cmp #2
    44 5117 B0 07		 bcs ov_sw
    45 5119 AD 30 13		 lda hmode
    46 511C C9 04		 cmp #PGV
    47 511E F0 0F		 beq ov_no
    48 5120 20 A2 96		ov_sw jsr ovlsw
