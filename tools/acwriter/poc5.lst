    28 4D1F			 icl 'word/msgs.inc'
Source: msgs.inc
     1 				; Message line texts (cmsg 20..39). Resident: the status line draws them in every mode, while the
     2 				; spell, edit and page code lives in the overlay slot (ovl.inc) and is swapped in on use.
     3 = 9C00			MSB = $9C00
     4 4D1F			spmsg
     5 4D1F A5 AC		 lda cmsg
     6 4D21 C9 14		 cmp #20
     7 4D23 D0 03		 bne spmx
     8 4D25 4C BC 51		 jmp o_spm20
     9 4D28 C9 21		spmx cmp #33
    10 4D2A D0 03		 bne spmy
    11 4D2C 4C 43 52		 jmp o_exrepm
    12 4D2F C9 1B		spmy cmp #27
    13 4D31 90 11		 bcc spmz
