    29 50FA			 icl 'word/ovl.inc'
Source: ovl.inc
     1 				; Overlay manager (resident part). The spell, edit and page code is assembled at SLA (one shared slot in
     2 				; main RAM) and stored in 130XE bank 2; a stub swaps the right image in before jumping to the routine.
     3 				; Needs the 128K machine (sv_xe = 1). Image ids: 0 = edit, 1 = spell, 2 = page.
     4 = 14F8			ovid  = $14F8                  ; image now in the slot ($FF = none)
     5 = 14F9			ovsa  = $14F9
     6 = 14FA			ovsx  = $14FA
     7 = 14FB			ovsy  = $14FB
     8 = 14FC			ovtg  = $14FC                  ; 2 bytes, followed by ovrq: the stub's inline data (target, image id)
     9 = 14FE			ovrq  = $14FE
    10
    11 				; ovstub name, target, image: 9 bytes; the JSR leaves the address of the inline data on the stack
    12 				 .macro ovstub
    13 				 sta ovsa
    14 				 jsr ovc
    15 				 dta a(:1),b(:2)
    16 				 .endm
    17
    18 50FA 8E FA 14		ovc stx ovsx
    19 50FD 8C FB 14		 sty ovsy
    20 5100 68			 pla
    21 5101 18			 clc
    22 5102 69 01		 adc #1
    23 5104 8D 10 51		 sta ovq+1
    24 5107 68			 pla
    25 5108 69 00		 adc #0
    26 510A 8D 11 51		 sta ovq+2
    27 510D A0 02		 ldy #2
    28 510F B9 FF FF		ovq lda $FFFF,y
    29 5112 99 FC 14		 sta ovtg,y
    30 5115 88			 dey
    31 5116 10 F7		 bpl ovq
    32 5118 AD F8 14		 lda ovid
    33 511B CD FE 14		 cmp ovrq
    34 511E F0 21		 beq ov_go
    35 5120 AD 5C 13		 lda sv_xe
    36 5123 F0 28		 beq ov_no
    37 5125 AD F8 14		 lda ovid
    38 5128 C9 02		 cmp #2
    39 512A 90 12		 bcc ov_sw
    40 512C C9 04		 cmp #4
    41 512E F0 0E		 beq ov_sw
    42 5130 AD FE 14		 lda ovrq
    43 5133 C9 02		 cmp #2
    44 5135 B0 07		 bcs ov_sw
    45 5137 AD 30 13		 lda hmode
    46 513A C9 04		 cmp #PGV
    47 513C F0 0F		 beq ov_no
    48 513E 20 A2 96		ov_sw jsr ovlsw
    49 5141 AE FA 14		ov_go ldx ovsx
    50 5144 AC FB 14		 ldy ovsy
    51 5147 AD F9 14		 lda ovsa
    52 514A 6C FC 14		 jmp (ovtg)
    53 				; refused: no extended RAM, or an edit/spell command while the page view is running
    54 514D A9 28		ov_no lda #40
    55 514F 85 AC		 sta cmsg
    56 5151 AE FA 14		 ldx ovsx
    57 5154 AC FB 14		 ldy ovsy
