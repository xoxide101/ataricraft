    55 1CE3 5E 4C 20 67 6F 74 +  dta c'^L goto line  ^A line start  ^E line end.',b(13)
    56 1D0D 46 69 6E 64 20 69 +  dta c'Find ignores case and wraps round the document.',b(13)
    57 1D3D 0D			 dta b(13)
    58 1D3E 01 53 70 65 6C 6C +  dta b(1),c'Spell check',b(1),b(13)
    59 1D4C 53 65 61 72 63 68 +  dta c'Search > Spell check checks from the cursor and',b(13)
    60 1D7C 73 74 6F 70 73 20 +  dta c'stops on each unknown word (shown inverse):',b(13)
    61 1DA8 20 49 20 69 67 6E +  dta c' I ignore  A ignore for this session  Esc stop',b(13)
    62 1DD7 20 31 2D 35 20 72 +  dta c' 1-5 replace with a suggestion (a letter deleted or',b(13)
    63 1E0B 20 74 77 6F 20 73 +  dta c' two swapped)  Return/N next. Needs D1:EN.CDC or',b(13)
    64 1E3C 48 3A 45 4E 2E 43 +  dta c'H:EN.CDC; a 130XE is needed for the 16 KB table.',b(13)
    65 1E6D 53 65 65 20 64 6F +  dta c'See docs/SPELL.md and docs/DICTIONARY.md.',b(13)
