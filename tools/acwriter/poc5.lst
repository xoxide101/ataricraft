    26 1866 0D			 dta b(13)
    27 1867 01 46 69 6C 65 73 +  dta b(1),c'Files',b(1),b(13)
    28 186F 4F 70 65 6E 2F 53 +  dta c'Open/Save ask for a name. Without a device it is D1:',b(13)
    29 18A4 61 6E 64 20 2E 58 +  dta c'and .XCW is added: D1:LETTER becomes D1:LETTER.XCW.',b(13)
    30 18D8 48 3A 4E 41 4D 45 +  dta c'H:NAME is used as typed (emulator host files).',b(13)
    31 1907 53 61 76 65 20 6B +  dta c'Save keeps the name; Save-As asks again.',b(13)
    32 1930 46 6F 72 6D 61 74 +  dta c'Format CRFT: 16 byte header + text stream, see',b(13)
    33 195F 64 6F 63 73 2F 43 +  dta c'docs/CRAFT-FORMAT.md. Codes: 13 end of paragraph,',b(13)
    34 1991 31 34 20 73 6F 66 +  dta c'14 soft line end, 1 bold, 2 italic, 3 underline.',b(13)
    35 19C2 0D			 dta b(13)
    36 19C3 01 49 6D 70 6F 72 +  dta b(1),c'Import / convert',b(1),b(13)
    37 19D6 4F 70 65 6E 20 6F +  dta c'Open on a file without a CRFT header reads it as plain',b(13)
