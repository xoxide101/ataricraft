   122 96A0			 icl 'word/ovlcopy.inc'
Source: ovlcopy.inc
     1 				; Overlay copy routines. Lives at $96A0, outside the $4000-$7FFF bank window and outside the slot, so it
     2 				; keeps running while bank 2 is mapped. The bank window and the slot overlap in address space, so every
     3 				; page goes bank -> LDB (bank mapped) -> slot (bank unmapped). Interrupts are masked meanwhile.
     4 96A0-9778> 00		ovlp dta b(0)                  ; pages left
     5 96A1 00			ovpb dta b(0)                  ; PORTB to restore
     6
     7 				; bank 2 (PORTB bits 2-3 = 10, bit 4 = 0: CPU sees the bank)
     8 96A2			ovlsw
     9 96A2 AE FE 14		 ldx ovrq
    10 96A5 BD E6 97		 lda ovbp,x
    11 96A8 8D CD 96		 sta ov1+2
    12 96AB BD E1 97		 lda ovnp,x
    13 96AE 8D A0 96		 sta ovlp
    14 96B1 A9 57		 lda #>SLA
    15 96B3 8D E1 96		 sta ov2+2
    16 96B6 78			 sei
    17 96B7 A9 00		 lda #0
    18 96B9 8D 0E D4		 sta NMIEN
    19 96BC AD 01 D3		 lda PORTB
    20 96BF 8D A1 96		 sta ovpb
    21 96C2 29 E3		ovl1 and #$E3
    22 96C4 09 08		 ora #$08
    23 96C6 8D 01 D3		 sta PORTB
    24 96C9 A0 00		 ldy #0
    25 96CB B9 00 40		ov1 lda $4000,y
    26 96CE 99 00 9F		 sta LDB,y
    27 96D1 C8			 iny
