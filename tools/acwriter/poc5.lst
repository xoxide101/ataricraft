     9 				 lda :a+1
    10 				 sbc :b+1
    11 				.endm
    12 				.macro mv16 a,b
    13 				 lda :a
    14 				 sta :b
    15 				 lda :a+1
    16 				 sta :b+1
    17 				.endm
