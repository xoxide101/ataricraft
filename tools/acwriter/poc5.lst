    78 				; PAGE mode (word/page.inc) and its 3 px glyph planes (craftpg.inc, from mkpgfont.cjs) sit in the top of the document area,
    79 				; $8400-$8FFF; the document is limited to $8400 (8 KB) so the page code is never overwritten (docs/ACWRITER-PAGE.md).
    80 96A0			 org $8400
    81 8400			 icl 'word/page.inc'
Source: page.inc
     1 				; PAGE mode (hmode = 4): a true-width page view. The editing engine is the normal one (insert, delete,
     2 				; reflow, cursor keys); only the drawing differs. The page is up to 144 columns of 4 px cells with the
     3 				; 12-row Craft cell (2 headroom rows, cap line, baseline, 3 descender rows), so lines advance 12 scanlines.
     4 				; Paper columns are scrolled horizontally to follow the cursor. Docs: docs/ACWRITER-PAGE.md.
     5 = 0004			PGV    = 4
     6 = 13E5			pwx    = $13E5               ; first paper column on screen
     7 = 13E6			pwrow  = $13E6
     8 = 13E7			pwsp   = $13E7               ; 1 superscript, 2 subscript
     9 = 13E8			pwsc   = $13E8               ; screen column being drawn
    10 = 13E9			pwpap  = $13E9               ; 0 letter, 1 A4, 2 legal
    11 = 13EA			pwpit  = $13EA               ; 0 10 cpi, 1 12 cpi, 2 17 cpi
    12 = 13EB			pwplm  = $13EB               ; left margin, columns
    13 = 13EC			pwprm  = $13EC               ; right margin, columns
    14 = 13ED			pwcols = $13ED               ; columns across the paper
    15 = 13EE			pwwid  = $13EE               ; usable columns
    16 = 13EF			pwlpp  = $13EF               ; text lines per page
    17 = 13F0			pwsl   = $13F0               ; saved lm / rm of the normal view
    18 = 13F1			pwsr   = $13F1
    19 = 13F2			pwcv   = $13F2               ; cursor column (visible characters before it)
    20 = 13F3			pwnt   = $13F3               ; tab stops
    21 = 13F4			pwcc   = $13F4
    22 = 13F5			pwch   = $13F5
    23 = 13F6			pwchg  = $13F6
    24 = 13F7			pwol   = $13F7               ; previous cursor line
    25 = 13F8			pwii    = $13F8
    26 = 13F9			pwdl   = $13F9
    27 = 13FA			pwdh   = $13FA
    28 = 13FB			pwa    = $13FB
    29 = 13FC			pwb    = $13FC
    30 = 13FD			pwc    = $13FD
    31 = 13FE			pwvx   = $13FE
    32 = 13FF			pwvw   = $13FF
    33 = 14E1			pwvy   = $14E1
    34 = 14E2			pwm0   = $14E2
    35 = 14E3			pwm1   = $14E3
    36 = 14E4			pwm2   = $14E4
    37 = 14E5			pwo    = $14E5               ; cursor pointer saved over a rewrap (2)
    38 = 14E8			pwtp   = $14E8               ; tab stop columns on the paper (8)
    39 = 14F0			pwtk   = $14F0               ; kinds 0 left, 1 centre, 2 right (8)
