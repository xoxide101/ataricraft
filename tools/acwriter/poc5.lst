     1 				; Typing style and alignment keys (overlay H). See docs/ACWRITER-PAGE.md for the key table.
     2 				; ^B ^I ^U ^T only set the style of the text typed next (pend, shown in the status line); the style codes
     3 				; are put in the document when the next character is typed.
     4 = BFEA			pcx = $BFEA
     5 = BFEB			pdf = $BFEB
     6 = BFEC			pdn = $BFEC
     7
     8 				; X = index into the key table styt: 0-3 style, 4-7 align, 8 Tab (indent on/off), 9-10 Shift-Tab / Ctrl-Tab (outdent)
     9 6057 E0 04		stykey cpx #4
    10 6059 B0 2A		 bcs sk3
    11 605B 8E EA BF		 stx pcx
    12 605E 20 2A 47		 jsr showsty
