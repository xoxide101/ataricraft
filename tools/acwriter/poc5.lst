    69 0583 C8			 iny
    70 0584 C0 28		 cpy #40
    71 0586 B0 13		 bcs cut5
    72 0588 AD EE 05		 lda cum1
    73 058B 51 86		 eor (sp),y
    74 058D 91 86		 sta (sp),y
    75 058F C8			 iny
    76 0590 C0 28		 cpy #40
    77 0592 B0 07		 bcs cut5
    78 0594 AD EF 05		 lda cum2
    79 0597 51 86		 eor (sp),y
    80 0599 91 86		 sta (sp),y
    81 059B A5 86		cut5 lda sp
    82 059D 18			 clc
