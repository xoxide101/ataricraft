Source: spellbk.inc
     1 				; Dictionary table access for the spell checker. Lives at $9300, outside the $4000-$7FFF window of the
     2 				; 130XE extended bank, so it stays visible while the bank is switched in. Interrupts are masked
     3 				; (NMIEN off) while the bank is mapped because the code at $4000-$4BFF is hidden then.
     4
     5 6368			 org DNM
     6 1450-1459> 44 31 3A 45 +  dta c'D1:EN.CDC',b($9B)
     7 145A			 org DNM2
     8 1470-1478> 48 3A 45 4E +  dta c'H:EN.CDC',b($9B)
     9
    10 1479			 org $9300
    11
    12 				; A = byte at table offset sv_bo (16 bit)
    13 9300			bk_get
    14 9300-93C0> AD 68 13	 lda sv_bo+1
    15 9303 18			 clc
    16 9304 6D 5D 13		 adc sv_tb
    17 9307 8D 1A 93		 sta bkg1+2
    18 930A 8D 23 93		 sta bkg2+2
    19 930D AE 67 13		 ldx sv_bo
    20 9310 AD 5C 13		 lda sv_xe
    21 9313 F0 0C		 beq bkg0
    22 9315 20 46 93		 jsr bk_in
    23 9318 BD 00 FF		bkg1 lda $FF00,x
    24 931B A8			 tay
    25 931C 20 5A 93		 jsr bk_out
    26 931F 98			 tya
    27 9320 60			 rts
    28 9321			bkg0
    29 9321 BD 00 FF		bkg2 lda $FF00,x
    30 9324 60			 rts
    31
    32 				; copy LDB (256 bytes) to table page A
    33 9325			bk_put
