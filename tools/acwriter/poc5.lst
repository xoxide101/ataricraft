    28 4D6E			 icl 'word/msgs.inc'
Source: msgs.inc
     1 				; Message line texts (cmsg 20..39). Resident: the status line draws them in every mode, while the
     2 				; spell, edit and page code lives in the overlay slot (ovl.inc) and is swapped in on use.
     3 = 9C00			MSB = $9C00
     4 4D6E			spmsg
     5 4D6E A5 AC		 lda cmsg
     6 4D70 C9 14		 cmp #20
     7 4D72 D0 03		 bne spmx
     8 4D74 4C 0B 52		 jmp o_spm20
     9 4D77 C9 21		spmx cmp #33
