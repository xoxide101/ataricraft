     6 1514 54 79 70 65 20 74 +  dta c'Type to insert. Arrows move. Return ends a paragraph.',b(13)
     7 154A 42 61 63 6B 73 70 +  dta c'Backspace deletes. Ctrl-arrows move by word/page.',b(13)
     8 157C 5E 42 20 62 6F 6C +  dta c'^B bold  ^I italic  ^U underline (toggle while typing).',b(13)
     9 15B4 45 73 63 20 6F 70 +  dta c'Esc opens the menu bar; press the underlined letter.',b(13)
    10 15E9 5E 58 20 6F 70 65 +  dta c'^X opens the command line. F1 or Help = this page.',b(13)
    11 161C 0D			 dta b(13)
    12 161D 01 4D 65 6E 75 73 +  dta b(1),c'Menus',b(1),b(13)
    13 1625 46 69 6C 65 3A 20 +  dta c'File: New Open Save Save-As, Home page, Help page.',b(13)
    14 1658 45 64 69 74 3A 20 +  dta c'Edit: Cut Copy Paste Mark Top End (no Undo yet).',b(13)
    15 1689 53 65 61 72 63 68 +  dta c'Search: F find N next R replace G goto line,',b(13)
    16 16B6 20 53 20 73 70 65 +  dta c' S spell check (^K), D dictionary name.',b(13)
    17 16DE 43 68 61 72 61 63 +  dta c'Character: bold, italic, underline, W width, T tall,',b(13)
    18 1713 20 4C 20 6C 61 72 +  dta c' L larger, S smaller, P superscript, D subscript,',b(13)
    19 1745 20 4F 20 66 6F 6E +  dta c' O fonts, N no-break space, H no-break hyphen,',b(13)
    20 1774 20 59 20 73 79 6D +  dta c' Y symbol picker (pick a symbol, Return inserts it).',b(13)
    21 17A9 50 61 72 61 67 72 +  dta c'Paragraph: L left, C centre, R right, J justify,',b(13)
    22 17DA 20 42 20 62 75 6C +  dta c' B bullet, I indent, G spacer.',b(13)
    23 17F9 44 6F 63 75 6D 65 +  dta c'Document: R ruler/zoom, M margins, B bars invert,',b(13)
    24 182B 20 43 20 63 6F 6C +  dta c' C colour themes, Z size, L line, H highlight,',b(13)
    25 185A 20 47 20 6C 65 67 +  dta c' G legend.',b(13)
    26 1865 0D			 dta b(13)
    27 1866 01 46 69 6C 65 73 +  dta b(1),c'Files',b(1),b(13)
    28 186E 4F 70 65 6E 2F 53 +  dta c'Open/Save ask for a name. Without a device it is D1:',b(13)
    29 18A3 61 6E 64 20 2E 43 +  dta c'and .CWD is added: D1:LETTER becomes D1:LETTER.CWD.',b(13)
    30 18D7 48 3A 4E 41 4D 45 +  dta c'H:NAME is used as typed (emulator host files).',b(13)
    31 1906 53 61 76 65 20 6B +  dta c'Save keeps the name; Save-As asks again.',b(13)
    32 192F 46 6F 72 6D 61 74 +  dta c'Format CRFT: 16 byte header + text stream, see',b(13)
    33 195E 64 6F 63 73 2F 43 +  dta c'docs/CRAFT-FORMAT.md. Codes: 13 end of paragraph,',b(13)
    34 1990 31 34 20 73 6F 66 +  dta c'14 soft line end, 1 bold, 2 italic, 3 underline.',b(13)
    35 19C1 0D			 dta b(13)
    36 19C2 01 49 6D 70 6F 72 +  dta b(1),c'Import / convert',b(1),b(13)
    37 19D5 4F 70 65 6E 20 6F +  dta c'Open on a file without a CRFT header reads it as plain',b(13)
    38 1A0C 74 65 78 74 20 6F +  dta c'text or ATASCII: lines wrap at 64 columns, inverse',b(13)
