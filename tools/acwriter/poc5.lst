    68 				; line 0 is the logo; entries start at line EL0, each 12 scanlines tall at double width
    69 				; the home and convert pages are image 4 of the overlay manager (expanded by poc5.asm), shown from the slot
    70 				 .macro homebody
    71 				 dta b(15),b(10),b(30),b(1),c'A C  W R I T E R',b(1),b(13)
    72 				 dta b(15),b(5),c'----------------------------------------------------------------',b(13)
    73 				 dta b(15),c'Word processor for the Atari 8-bit',b(13)
    74 				 dta b(15),c'Version 0.1 proof of concept',b(13)
    75 				 dta b(13)
    76 				 dta b(7),b(28),b(31),c'    N   New document       ',b(31),b(13)
    77 				 dta b(7),b(28),b(31),c'    O   Open document      ',b(31),b(13)
    78 				 dta b(7),b(28),b(31),c'    S   Save               ',b(31),b(13)
    79 				 dta b(7),b(28),b(31),c'    A   Save as            ',b(31),b(13)
    80 				 dta b(7),b(28),b(31),c'    C   Convert / import   ',b(31),b(13)
    81 				 dta b(7),b(28),b(31),c'    H   Help (F1)          ',b(31),b(13)
    82 				 dta b(7),b(28),b(31),c'    E   Edit document      ',b(31),b(13)
    83 				 dta b(7),b(28),b(31),c'    Q   Quit               ',b(31),b(13)
    84 				 dta b(0)
    85 				
    86 				 .endm
    87 				 .macro convbody
    88 				 dta b(15),b(7),b(28),b(1),c'CONVERT / IMPORT',b(1),b(13)
    89 				 dta b(13)
    90 				 dta c'Reads a plain text or ATASCII file and turns it into an',b(13)
    91 				 dta c'ACWriter document. It replaces the document in memory.',b(13)
    92 				 dta c' - lines wrap at 64 columns (soft breaks)',b(13)
    93 				 dta c' - inverse video becomes underline',b(13)
    94 				 dta c' - Ctrl-C at the start of a line centres it',b(13)
    95 				 dta c' - other control codes are dropped',b(13)
    96 				 dta b(13)
    97 				 dta c'Press I or Return, then type the file name. The default',b(13)
    98 				 dta c'device is D1:  H:NAME works in the emulator.',b(13)
    99 				 dta c'File > Open does the same for any file that is not an',b(13)
   100 				 dta c'ACWriter (CRFT) file.',b(13)
   101 				 dta b(13)
   102 				 dta c'Letter Perfect, PaperClip, Text Wizard, Bank Street,',b(13)
   103 				 dta c'RTF and Word files: convert on the PC first with',b(13)
   104 				 dta c'  node tools/craftimport.cjs INPUT OUTPUT.CWD',b(13)
   105 				 dta c'Then press E to edit the result.',b(13)
   106 				 dta b(0)
   107 				 .endm
