    20 512F 68			 pla
    21 5130 18			 clc
    22 5131 69 01		 adc #1
    23 5133 8D 3F 51		 sta ovq+1
    24 5136 68			 pla
    25 5137 69 00		 adc #0
    26 5139 8D 40 51		 sta ovq+2
    27 513C A0 02		 ldy #2
    28 513E B9 FF FF		ovq lda $FFFF,y
    29 5141 99 FC 14		 sta ovtg,y
    30 5144 88			 dey
    31 5145 10 F7		 bpl ovq
    32 5147 AD F8 14		 lda ovid
    33 514A CD FE 14		 cmp ovrq
    34 514D F0 21		 beq ov_go
    35 514F AD 5C 13		 lda sv_xe
    36 5152 F0 28		 beq ov_no
    37 5154 AD F8 14		 lda ovid
    38 5157 C9 02		 cmp #2
    39 5159 90 12		 bcc ov_sw
    40 515B C9 04		 cmp #4
    41 515D F0 0E		 beq ov_sw
    42 515F AD FE 14		 lda ovrq
    43 5162 C9 02		 cmp #2
    44 5164 B0 07		 bcs ov_sw
    45 5166 AD 30 13		 lda hmode
    46 5169 C9 04		 cmp #PGV
    47 516B F0 0F		 beq ov_no
    48 516D 20 A2 96		ov_sw jsr ovlsw
    49 5170 AE FA 14		ov_go ldx ovsx
    50 5173 AC FB 14		 ldy ovsy
    51 5176 AD F9 14		 lda ovsa
    52 5179 6C FC 14		 jmp (ovtg)
    53 				; refused: no extended RAM, or an edit/spell command while the page view is running
    54 517C A9 28		ov_no lda #40
    55 517E 85 AC		 sta cmsg
