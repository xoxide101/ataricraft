    23 5158 8D 64 51		 sta ovq+1
    24 515B 68			 pla
    25 515C 69 00		 adc #0
    26 515E 8D 65 51		 sta ovq+2
    27 5161 A0 02		 ldy #2
    28 5163 B9 FF FF		ovq lda $FFFF,y
    29 5166 99 FC 14		 sta ovtg,y
    30 5169 88			 dey
    31 516A 10 F7		 bpl ovq
    32 516C AD F8 14		 lda ovid
    33 516F CD FE 14		 cmp ovrq
    34 5172 F0 21		 beq ov_go
    35 5174 AD 5C 13		 lda sv_xe
    36 5177 F0 28		 beq ov_no
    37 5179 AD F8 14		 lda ovid
    38 517C C9 02		 cmp #2
    39 517E 90 12		 bcc ov_sw
    40 5180 C9 04		 cmp #4
    41 5182 F0 0E		 beq ov_sw
    42 5184 AD FE 14		 lda ovrq
    43 5187 C9 02		 cmp #2
    44 5189 B0 07		 bcs ov_sw
    45 518B AD 30 13		 lda hmode
    46 518E C9 04		 cmp #PGV
    47 5190 F0 0F		 beq ov_no
    48 5192 20 A2 96		ov_sw jsr ovlsw
    49 5195 AE FA 14		ov_go ldx ovsx
    50 5198 AC FB 14		 ldy ovsy
