    29 5346			 icl 'word/diskfs.inc'
Source: diskfs.inc
     1 				; D: device handler for the self-booting ACWriter disk. A small Atari DOS 2 compatible file system (single
     2 				; density, 128 byte sectors): VTOC at sector 360, directory at 361..368, data sectors with the usual 3 byte
     3 				; link (125 data bytes, file number + next sector, byte count). One file open at a time, read (4) or write (8);
     4 				; writing an existing name replaces it. The disk is laid out by scripts/build-acwriter-atr.cjs.
     5 				; It is installed by ddinit only when no D: handler exists (so under a real DOS, DOS keeps D:).
     6 = 0400			DDB  = $0400                   ; data sector buffer (cassette buffer)
     7 = 0300			DDEVIC = $0300
     8 = 0301			DUNIT  = $0301
     9 = 0302			DCOMND = $0302
    10 = 0303			DSTATS = $0303
