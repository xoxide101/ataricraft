     3 				; are put in the document when the next character is typed.
     4 = BFEA			pcx = $BFEA
     5 = BFEB			pdf = $BFEB
     6 = BFEC			pdn = $BFEC
     7
     8 				; X = index into the key table styt: 0-3 style, 4-7 align, 8 Tab (indent on/off), 9-10 Shift-Tab / Ctrl-Tab (outdent)
     9 6060 E0 04		stykey cpx #4
    10 6062 B0 2A		 bcs sk3
    11 6064 8E EA BF		 stx pcx
    12 6067 20 33 47		 jsr showsty
    13 606A AD E9 BF		 lda stv
    14 606D 8D E5 BF		 sta pend
    15 6070 AE EA BF		 ldx pcx
    16 6073 BD 16 61		 lda pcb,x
    17 6076 4D E5 BF		 eor pend
    18 6079 8D E5 BF		 sta pend
    19 607C A5 93		 lda cl
    20 607E 8D E7 BF		 sta pvl
    21 6081 A5 94		 lda cc
    22 6083 8D E8 BF		 sta pvc
    23 6086 A9 01		 lda #1
    24 6088 8D E6 BF		 sta pvf
    25 608B 4C 70 48		 jmp status
    26 608E E0 08		sk3 cpx #8
    27 6090 B0 06		 bcs sk5
    28 6092 BD 16 61		 lda sal-4,x
    29 6095 4C C1 32		 jmp cmdexec
    30 6098 D0 0F		sk5 bne sk6
    31 609A AD 30 13		 lda hmode
    32 609D C9 04		 cmp #PGV
    33 609F D0 03		 bne sk5a
    34 60A1 4C A6 52		 jmp pwtab
    35 60A4 A9 18		sk5a lda #24
    36 60A6 4C C1 32		 jmp cmdexec
    37 60A9 20 B4 60		sk6 jsr sk9
    38 60AC F0 05		 beq sk8
    39 60AE A9 18		 lda #24
    40 60B0 4C C1 32		 jmp cmdexec
    41 60B3 60			sk8 rts
    42 60B4 A9 12		sk9 lda #18
    43 60B6 85 E1		 sta pcs
    44 60B8 A9 13		 lda #19
    45 60BA 85 E2		 sta pch1
    46 60BC A6 93		 ldx cl
    47 60BE 4C BE 3F		 jmp pfind
    48
    49 				; first typed character after a style change: close the changed styles in front of the text that follows
    50 				; (so it keeps its own style), then open them and put the character in
    51 60C1 20 42 41		ptype jsr curstyle
    52 60C4 4D E5 BF		 eor pend
    53 60C7 8D EB BF		 sta pdf
    54 60CA A9 00		 lda #0
    55 60CC 8D E6 BF		 sta pvf
    56 60CF AD EB BF		 lda pdf
    57 60D2 F0 18		 beq pt1
    58 60D4 20 30 41		 jsr curptr
    59 60D7 A0 00		 ldy #0
    60 60D9 B1 80		 lda (src),y
    61 60DB F0 0F		 beq pt1
    62 60DD C9 0D		 cmp #13
    63 60DF F0 0B		 beq pt1
    64 60E1 20 F4 60		 jsr pcodes
    65 60E4 20 C0 41		pt0 jsr kleft
    66 60E7 CE EC BF		 dec pdn
    67 60EA D0 F8		 bne pt0
    68 60EC 20 F4 60		pt1 jsr pcodes
    69 60EF A5 9C		 lda kk
    70 60F1 4C 27 42		 jmp insert
    71 60F4 A2 00		pcodes ldx #0
    72 60F6 8E EC BF		 stx pdn
    73 60F9 AD EB BF		pc1 lda pdf
    74 60FC 3D 16 61		 and pcb,x
    75 60FF F0 0F		 beq pc2
    76 6101 8E EA BF		 stx pcx
    77 6104 BD BA 3F		 lda stcode,x
    78 6107 20 27 42		 jsr insert
    79 610A EE EC BF		 inc pdn
    80 610D AE EA BF		 ldx pcx
    81 6110 E8			pc2 inx
    82 6111 E0 04		 cpx #4
    83 6113 90 E4		 bcc pc1
    84 6115 60			 rts
    85 6116 01 02 04 40		pcb dta b(1),b(2),b(4),b($40)
    86 611A 14 15 16 17		sal dta b(20),b(21),b(22),b(23)
   175 = 611E			e_end = *
   176 				 .if e_end>SLA+$0C00
   177 				 .error 'overlay image too big'
   178 				 .endif
   179 				 .endl
   180 02E0-02E1> 00 20		 run start
