Source: spellbk.inc
     1 				; Dictionary table access for the spell checker. Lives at $9300, outside the $4000-$7FFF window of the
     2 				; 130XE extended bank, so it stays visible while the bank is switched in. Interrupts are masked
     3 				; (NMIEN off) while the bank is mapped because the code at $4000-$4BFF is hidden then.
     4
     5 6500			 org DNM
     6 1450-1459> 44 31 3A 45 +  dta c'D1:EN.CDC',b($9B)
     7 145A			 org DNM2
     8 1470-1478> 48 3A 45 4E +  dta c'H:EN.CDC',b($9B)
     9
    10 1479			 org $9300
    11
    12 				; A = byte at table offset sv_bo (16 bit)
    13 9300			bk_get
    14 9300-93C0> AD 68 13	 lda sv_bo+1
    15 9303 18			 clc
    16 9304 6D 5D 13		 adc sv_tb
    17 9307 8D 1A 93		 sta bkg1+2
    18 930A 8D 23 93		 sta bkg2+2
    19 930D AE 67 13		 ldx sv_bo
    20 9310 AD 5C 13		 lda sv_xe
    21 9313 F0 0C		 beq bkg0
    22 9315 20 46 93		 jsr bk_in
    23 9318 BD 00 FF		bkg1 lda $FF00,x
    24 931B A8			 tay
    25 931C 20 5A 93		 jsr bk_out
    26 931F 98			 tya
    27 9320 60			 rts
    28 9321			bkg0
    29 9321 BD 00 FF		bkg2 lda $FF00,x
    30 9324 60			 rts
    31
    32 				; copy LDB (256 bytes) to table page A
    33 9325			bk_put
    34 9325 18			 clc
    35 9326 6D 5D 13		 adc sv_tb
    36 9329 8D 41 93		 sta bkp1+2
    37 932C AD 5C 13		 lda sv_xe
    38 932F F0 09		 beq bkp0
    39 9331 20 46 93		 jsr bk_in
    40 9334 20 3A 93		 jsr bkp
    41 9337 4C 5A 93		 jmp bk_out
    42 933A			bkp0
    43 933A A0 00		bkp ldy #0
    44 933C B9 00 9F		bkp2 lda LDB,y
    45 933F 99 00 FF		bkp1 sta $FF00,y
    46 9342 C8			 iny
    47 9343 D0 F7		 bne bkp2
    48 9345 60			 rts
    49
    50 9346			bk_in
    51 9346 78			 sei
    52 9347 A9 00		 lda #0
    53 9349 8D 0E D4		 sta NMIEN
    54 934C AD 01 D3		 lda PORTB
    55 934F 8D 7E 13		 sta sv_t
    56 9352 29 E3		 and #$E3
    57 9354 09 04		 ora #$04
    58 9356 8D 01 D3		 sta PORTB
    59 9359 60			 rts
    60
    61 935A			bk_out
    62 935A AD 7E 13		 lda sv_t
    63 935D 8D 01 D3		 sta PORTB
    64 9360 A9 C0		 lda #$C0
    65 9362 8D 0E D4		 sta NMIEN
    66 9365 58			 cli
    67 9366 60			 rts
    68
    69 				; sv_xe = 1 when bank 1 is a separate 16 KB of RAM (130XE), else 0
    70 9367			bk_det
    71 9367 A9 00		 lda #0
    72 9369 8D 5C 13		 sta sv_xe
    73 936C 78			 sei
    74 936D 8D 0E D4		 sta NMIEN
    75 9370 AD FF 7F		 lda $7FFF
    76 9373 8D 7D 13		 sta sv_hm
    77 9376 AD 01 D3		 lda PORTB
    78 9379 48			 pha
    79 937A 29 E3		 and #$E3
    80 937C 09 04		 ora #$04
    81 937E 8D 01 D3		 sta PORTB
    82 9381 AD FF 7F		 lda $7FFF
    83 9384 8D 7C 13		 sta sv_ty
    84 9387 A9 A5		 lda #$A5
    85 9389 8D FF 7F		 sta $7FFF
    86 938C 68			 pla
    87 938D 48			 pha
    88 938E 8D 01 D3		 sta PORTB
    89 9391 A9 5A		 lda #$5A
    90 9393 8D FF 7F		 sta $7FFF
    91 9396 AD 01 D3		 lda PORTB
    92 9399 29 E3		 and #$E3
    93 939B 09 04		 ora #$04
    94 939D 8D 01 D3		 sta PORTB
    95 93A0 AD FF 7F		 lda $7FFF
    96 93A3 C9 A5		 cmp #$A5
    97 93A5 D0 09		 bne bkd1
    98 93A7 EE 5C 13		 inc sv_xe
    99 93AA AD 7C 13		 lda sv_ty
   100 93AD 8D FF 7F		 sta $7FFF
   101 93B0 68			bkd1 pla
