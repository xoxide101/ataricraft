    28 4D4E			 icl 'word/msgs.inc'
Source: msgs.inc
     1 				; Message line texts (cmsg 20..39). Resident: the status line draws them in every mode, while the
     2 				; spell, edit and page code lives in the overlay slot (ovl.inc) and is swapped in on use.
     3 = 9C00			MSB = $9C00
     4 4D4E			spmsg
     5 4D4E A5 AC		 lda cmsg
     6 4D50 C9 14		 cmp #20
     7 4D52 D0 03		 bne spmx
     8 4D54 4C EB 51		 jmp o_spm20
     9 4D57 C9 21		spmx cmp #33
