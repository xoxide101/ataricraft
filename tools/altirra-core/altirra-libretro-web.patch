 extern "C" void ATLibretroSetDiskLedState(uint32 index, bool active);
+// Activity counters polled by the web front end: +2 per event, bit 0 set when any event was a write.
+// Ids: 0-14 disk LEDs, 15 H:, 16 IDE, 17 PCLink, 18 flash write, 19 cartridge.
+extern "C" uint32 g_ATLibretroAct[24] = {};
+static inline void ATLibretroAct(uint32 id, bool write) { if (id < 24) g_ATLibretroAct[id] += 2, g_ATLibretroAct[id] |= write ? 1u : 0u; }
 
