+	void SetIDEActivity(bool w, uint32) override { ATLibretroAct(16, w); }
+	void SetPCLinkActivity(bool w) override { ATLibretroAct(17, w); }
+	void SetFlashWriteActivity() override { ATLibretroAct(18, true); }
