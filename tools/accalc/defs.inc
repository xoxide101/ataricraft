INBUFF = $F3
AFP    = $D800                ; ASCII at INBUFF+CIX -> FR0
IFP    = $D9AA                ; integer in FR0/FR0+1 -> FP
FPI    = $D9D2                ; FR0 -> integer in FR0/FR0+1
