Source: calc.inc
     1 				; Formula evaluator and recalculation. Numbers are the 6 byte OS floating point (BCD) format.
     2 				; Value stack entries (8 bytes at VSTK + offset): byte 0 type, bytes 1.. payload
     3 				;   0 blank, 1 number (6 bytes), 2 string (heap pointer), 4 error (code in byte 1), 5 bool (byte 1), 6 reference/range (r1,c1,r2,c2)
     4 				; Excel precedence: comparison < + - < * / < ^ (left to right) < unary minus < %.
     5
     6 336E 40 01 00 00 00 00	K1   dta b($40),b($01),b(0),b(0),b(0),b(0)
     7 3374 41 01 00 00 00 00	K100 dta b($41),b($01),b(0),b(0),b(0),b(0)
     8 337A 40 10 00 00 00 00	K10  dta b($40),b($10),b(0),b(0),b(0),b(0)
     9 3380 3F 50 00 00 00 00	KHF  dta b($3F),b($50),b(0),b(0),b(0),b(0)
