  2744 				 .macro body
  2745 				 dta b(1),c'ACWord',b(1),c' hi-res page: 64 columns x 20 lines',b(13)
  2746 				 dta c'Normal, ',b(1),c'bold',b(1),c', ',b(2),c'italic',b(2),c' and ',b(4-1),c'underline',b(3),c' text.',b(13)
  2747 				 dta c'The quick brown fox jumps over a lazy dog 0123456789',b(13)
  2748 				 dta b(13)
  2749 				 dta c'Every glyph is drawn bit by bit at 5 pixels per',b(13)
  2750 				 dta c'character, so 64 columns fit across the page and',b(13)
  2751 				 dta c'the cursor can sit on any of 21 text lines.',b(13)
  2752 				 dta b(13)
  2753 				 dta b(1),b(2),c'Bold italic',b(2),b(1),c' works too, and ',b(3),b(1),c'bold underline',b(1),b(3),c'.',b(13)
  2754 				 dta c'Type here: letters insert, Return splits a line,',b(13)
  2755 				 dta c'backspace deletes and joins lines, Ctrl-arrows move',b(13)
  2756 				 dta b(13)
  2757 				 dta c'Scrolling is a block copy of 21 rows followed by',b(13)
  2758 				 dta c'drawing a single new line at the edge.',b(13)
  2759 				 dta b(13)
  2760 				 dta c'Objects, not bitmaps: the document is a short',b(13)
  2761 				 dta c'text stream with style codes, so it stays tiny.',b(13)
  2762 				 dta b(13)
  2763 				 dta c'A 1-page document fits in a few KB on a stock',b(13)
  2764 				 dta c'64K XL or XE, leaving the rest for art and fonts.',b(13)
  2765 				 dta b(13)
  2766 				 dta c'-- end of this block --',b(13)
  2767 				 .endm
  2768
  2769 38BF			 org DOC
  2770 5000			 body
