/roms/*
!/roms/altirra/
software_n_roms/
*.rom
*.ROM
*.atr
*.xex
*.car
*.cas
vendor/
web/ref/
node_modules/
target/
out/
books/
web/library/*
!web/library/craftapps/
web/library/craftapps/*
!web/library/craftapps/AFM/
web/js/diskdb.js

# archive: blank disks are tracked; DOS boot disks (third-party) stay local
!archive/blank/*.atr
!roms/altirra/*.rom

# the shareable AtariCraft Tools disk (our own tools only)
!web/library/craftapps/Tools/
!web/library/craftapps/Tools/*.atr

web/library/fonts/personal/
# generated font lists / extracted ROM charset, and the user's own downloaded fonts: never committed
web/library/fonts/local/
font_personal/

# EBookCraft optional OCR add-on (tesseract.js, installed by scripts/ebookcraft-install-ocr.cjs)
tools/ebookcraft/ocr/
web/js/ebookcraft/ocr/

# Private deploy target (never commit server addresses)
deploy.local.txt
